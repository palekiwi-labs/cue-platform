{
  "name": "@palekiwi-labs/cue-github",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cue-github": "dist/main.js"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "format": "prettier --write src test *.json",
    "format:check": "prettier --check src test *.json"
  },
  "dependencies": {
    "@nats-io/transport-node": "3.4.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
