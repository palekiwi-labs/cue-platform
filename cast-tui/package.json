    "start": "node bin/cast-tui.js"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
