{
  "name": "cast-tui",
  "version": "0.3.0-spike.1",
  "description": "Terminal UI for cast",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "cast-tui": "bin/cast-tui.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
